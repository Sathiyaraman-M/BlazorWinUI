@using BlazorWinUI.Components

<StackPanel>
    <Button Text="Increment" OnClick="IncrementCount" />
    <TextBlock Text="@CountText" />
</StackPanel>

@code {
    private int currentCount;

    private string CountText => $"Current count: {currentCount}";

    private void IncrementCount()
    {
        currentCount++;
    }
}
