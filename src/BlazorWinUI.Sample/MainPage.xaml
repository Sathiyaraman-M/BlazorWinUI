<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlazorWinUI_Sample.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:blazor="using:BlazorWinUI"
    xmlns:local="using:BlazorWinUI_Sample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Native WinUI shell" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="The content below is a Blazor-rendered section." />
            </StackPanel>
        </Border>

        <blazor:BlazorComponentHost
            x:Name="RootHost"
            Grid.Row="1"
            Renderer="{x:Bind Renderer, Mode=OneTime}"
            ComponentType="{x:Bind RootComponentType, Mode=OneTime}"
            HostError="RootHost_OnHostError" />
    </Grid>
</Page>
